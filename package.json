{
  "name": "studio-coop",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:migrate": "turbo db:migrate --filter=@studio-coop/db",
    "db:seed": "turbo db:seed --filter=@studio-coop/db",
    "deploy": "wrangler deploy",
    "deploy:web": "wrangler deploy",
    "deploy:web:dry": "wrangler deploy --dry-run",
    "deploy:api": "wrangler deploy -c packages/api/wrangler.toml --env=\"\"",
    "deploy:api:dry": "wrangler deploy -c packages/api/wrangler.toml --env=\"\" --dry-run",
    "deploy:all": "pnpm run deploy:api && pnpm run deploy:web",
    "deploy:all:dry": "pnpm run deploy:api:dry && pnpm run deploy:web:dry",
    "ship": "turbo ship --filter=@studio-coop/api --filter=@studio-coop/web",
    "ship:api": "turbo ship --filter=@studio-coop/api",
    "ship:web": "turbo ship --filter=@studio-coop/web"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
